{
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm --prefix apps/web *)",
      "Bash(npm install *)",
      "Bash(npm ci)",
      "Bash(npx eslint *)",
      "Bash(npx vite *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git branch *)",
      "Bash(docker compose *)",
      "Bash(docker build *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
