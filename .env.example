# Copy to .env and fill in. Never commit .env.
WEB_PORT=8081
APP_PORT=8080
# Password for the app's admin view. Without one, admin is open in development and switched off in production.
ADMIN_PASSWORD=
# Folder with a client's estate.json + settings.json (keep client files in estates/, which git ignores).
# Leave empty to run the fictional demo estate.
# ESTATE_DIR=./estates/<client>
# Platform (later)
# DATABASE_URL=postgres://alfamaps:alfamaps@localhost:5432/alfamaps
# SESSION_SECRET=change-me
